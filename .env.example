# Rent Radar: environment variables.
# Copy to .env and fill in. .env is gitignored; never commit it.

# Local Postgres (docker compose). The password goes inside a URL, so keep it
# to letters and digits.
POSTGRES_USER=rentradar
POSTGRES_PASSWORD=<password>
POSTGRES_DB=rentradar
# Host port, loopback only.
POSTGRES_PORT=5434

# File holding ONE Apprise URL, e.g. mailto://user:app-password@gmail.com?to=you@example.com
# It contains a password: keep it out of git and readable by the container user.
APPRISE_URL_FILE=./apprise-url.txt

# Server only. The image to run (pulled from the registry instead of built), the
# address the Prefect UI listens on, and the host name or IP you open it with.
# RENT_RADAR_IMAGE=ghcr.io/marcospozzo/rent-radar:latest
# BIND_ADDRESS=0.0.0.0
# PUBLIC_HOST=192.168.1.50
